# DukAI shared environment — ONE file for frontend + backend.
#   cp .env.example .env
#   # edit secrets, then start backend + frontend (no DUKAI_ENV file switching)

APP_NAME=DukAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:7100
APP_PORT=7001
FRONTEND_URL=http://127.0.0.1:7100

APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dukai
# DB_USERNAME=dukai
# DB_PASSWORD=
# DB_ROOT_PASSWORD=root   # production / Docker MySQL only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_SECRET=change-me-same-value-on-uat-and-prod
SESSION_COOKIE_NAME=dukai_session
SESSION_MAX_AGE=7200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:7100,127.0.0.1,127.0.0.1:7100
CORS_ALLOWED_ORIGINS=http://127.0.0.1:7100,http://localhost:7100,http://127.0.0.1:8081,http://localhost:8081
OAUTH_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:7100,http://localhost:7100

# Meta / Instagram — use separate Meta apps for UAT vs production hosts (each host has its own .env)
META_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Google Sign-In (merchant signup/login). Leave empty to hide the Google button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:7001/auth/google/callback
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_FAKE_MESSAGING=true
INSTAGRAM_SHOW_SIMULATE_DM=true

# Instagram Beta (session-based outbound via instagrapi)
# UAT: INSTAGRAM_BETA_ENABLED=true  INSTAGRAM_OUTBOUND_TRANSPORT=auto
# Prod: INSTAGRAM_BETA_ENABLED=false INSTAGRAM_OUTBOUND_TRANSPORT=official
INSTAGRAM_BETA_ENABLED=false
INSTAGRAM_OUTBOUND_TRANSPORT=official
SALES_AUTOPILOT_ENABLED=true

MPESA_SANDBOX_CONSUMER_KEY=
MPESA_SANDBOX_CONSUMER_SECRET=
MPESA_SANDBOX_PASSKEY=
MPESA_SANDBOX_B2B_INITIATOR=
MPESA_SANDBOX_B2B_SECURITY_CREDENTIAL=
MPESA_SANDBOX_B2B_AUTO_PAYOUT=false

# production | sandbox — when set, overrides the admin Mode toggle for Daraja only
MPESA_MODE=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_SHORTCODE_TYPE=paybill
# Leave empty to use {APP_URL}/mpesa/callback (must be public HTTPS for live STK).
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE_PREFIX=PAY
MPESA_B2B_INITIATOR=
MPESA_B2B_SECURITY_CREDENTIAL=
MPESA_B2B_AUTO_PAYOUT=false

MAIL_ENABLED=false
MAILTRAP_API_TOKEN=
MAIL_FROM_ADDRESS=hello@demomailtrap.co
MAIL_FROM_NAME=DUKAI PLATFORM

GOOGLE_MAPS_API_KEY=
# Optional: Cloud map ID for Advanced Markers (Google Cloud Console → Map Management).
GOOGLE_MAPS_MAP_ID=

IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

DM_AGENT_ENABLED=true
DM_AGENT_PROVIDER=auto
COMMENT_AGENT_ENABLED=true
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GEMINI_CHAT_MODEL=gemini-2.5-flash

BACKEND_URL=http://127.0.0.1:7001
NEXT_PUBLIC_API_URL=
# Frontend debug UI (diagnostic panels + replace Next "Rendering…" with loading effect).
# Defaults to on in non-production if unset. Truthy: 1 | true | yes
NEXT_PUBLIC_DEBUG=true
