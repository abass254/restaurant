# TransChap shared environment — ONE file for frontend + backend.
#   cp .env.example .env
#   # edit secrets, then start backend + frontend (no TRANSCHAP_ENV file switching)

APP_NAME=TransChap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Docker Compose sets APP_ENV=production and APP_DEBUG=false on the backend.
# APP_ENV=production also forces debug off even if APP_DEBUG=true.
# Public origin the Instagram hub returns to after Meta login.
# Local: keep these on localhost (do NOT point local at merchants.TransChap.app).
# Prod (merchants.TransChap.app):
#   APP_URL=https://merchants.TransChap.app
#   FRONTEND_URL=https://merchants.TransChap.app
APP_URL=http://127.0.0.1:7100
APP_PORT=7001
FRONTEND_URL=http://127.0.0.1:7100

# Uploads disk root (optional).
# Docker: leave unset; files land in container `/app/uploads`.
#   Local Compose uses named volume `backend_uploads`.
#   Prod Compose: uses the persistent backend_uploads volume by default.
#   Use a reviewed Compose override for a host bind mount.
# Bare metal: UPLOADS_DIR=/home/ubuntu/agents/uploads (or repo backend/uploads/).
# Public base URL is always {APP_URL|FRONTEND_URL}/uploads/ — e.g.
#   https://merchants.TransChap.app/uploads/products/<id>/<sha>.png
# When this laptop/API uses production data but APP_URL stays on localhost,
# set UPLOADS_PUBLIC_BASE_URL so /uploads/* resolve to the live media host:
#   UPLOADS_PUBLIC_BASE_URL=https://merchants.TransChap.app
# Push local disk files that are missing remotely with:
#   ./scripts/push-uploads-to-prod.sh
# UPLOADS_DIR=
UPLOADS_PUBLIC_BASE_URL=https://merchants.TransChap.app

APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=TransChap
# DB_USERNAME=TransChap
# Required for docker compose (MySQL). Do not use TransChap, root, or password.
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# Connection pool for the single FastAPI process (pool + overflow must stay
# under MySQL max_connections / max_user_connections).
# DB_POOL_SIZE=4
# DB_MAX_OVERFLOW=1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Local placeholder only. Production / Docker refuse to boot if this is unchanged.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-same-value-on-uat-and-prod
SESSION_COOKIE_NAME=TransChap_session
SESSION_MAX_AGE=7200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:7100,127.0.0.1,127.0.0.1:7100
CORS_ALLOWED_ORIGINS=http://127.0.0.1:7100,http://localhost:7100,http://127.0.0.1:8081,http://localhost:8081
OAUTH_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:7100,http://localhost:7100

# Meta / Instagram — use separate Meta apps for UAT vs production hosts (each host has its own .env)
META_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Google Sign-In (merchant signup/login). Leave empty to hide the Google button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:7001/auth/google/callback
META_APP_SECRET=
# Same Meta app as TransChap.app. Token exchange uses the hub redirect URI — never this app's.
INSTAGRAM_HUB_URL=https://TransChap.app
TRANSCHAP_PLATFORM=merchant
# Must match Meta + the hub exactly
INSTAGRAM_REDIRECT_URI=https://TransChap.app/instagram/callback
INSTAGRAM_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

INSTAGRAM_FAKE_MESSAGING=true
INSTAGRAM_SHOW_SIMULATE_DM=true

# Instagram Beta (session-based outbound via instagrapi)
# UAT: INSTAGRAM_BETA_ENABLED=true  INSTAGRAM_OUTBOUND_TRANSPORT=auto
# Prod: INSTAGRAM_BETA_ENABLED=false INSTAGRAM_OUTBOUND_TRANSPORT=official
INSTAGRAM_BETA_ENABLED=false
INSTAGRAM_OUTBOUND_TRANSPORT=official
SALES_AUTOPILOT_ENABLED=true

MPESA_SANDBOX_CONSUMER_KEY=
MPESA_SANDBOX_CONSUMER_SECRET=
MPESA_SANDBOX_PASSKEY=
MPESA_SANDBOX_B2B_INITIATOR=
MPESA_SANDBOX_B2B_SECURITY_CREDENTIAL=
MPESA_SANDBOX_B2B_AUTO_PAYOUT=false

# production | sandbox — when set, overrides the admin Mode toggle for Daraja only
MPESA_MODE=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_SHORTCODE_TYPE=paybill
# Leave empty to use {APP_URL}/mpesa/callback (must be public HTTPS for live STK).
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE_PREFIX=PAY
MPESA_B2B_INITIATOR=
MPESA_B2B_SECURITY_CREDENTIAL=
MPESA_B2B_AUTO_PAYOUT=false
# Skip Utility→Working before B2B. Till/Paybill debit Working; STK still lands in Utility.
MPESA_B2B_UTILITY_TO_WORKING=false

# --- Tigo Pesa / Mixx by Yas (Tanzania) ---
# No public developer portal: request credentials from inquiry.mfscorporate@mixx.co.tz
# production | sandbox — when set, overrides the admin Mode toggle for Tigo only
TIGO_MODE=sandbox
TIGO_CLIENT_ID=
TIGO_CLIENT_SECRET=
# Tigo Secure gateway. Defaults are the Millicom sandbox/production hosts.
TIGO_SANDBOX_BASE_URL=https://securesandbox.tigo.com
TIGO_BASE_URL=https://secure.tigo.com
# Partner gateway for XML bill pay + A2W disbursement. Provisioned per partner.
TIGO_PARTNER_BASE_URL=
# Our master-merchant wallet — the account that collects and disburses.
TIGO_ACCOUNT_MSISDN=
TIGO_ACCOUNT_PIN=
TIGO_MASTER_MERCHANT_ID=
# Biller code customers pay to (COMPANYNAME on inbound bill pay).
TIGO_BILLER_CODE=
# Leave empty to use {APP_URL}/tigo/callback and {APP_URL}/tigo/return.
TIGO_CALLBACK_URL=
TIGO_REDIRECT_URL=
# Tigo authenticates its inbound callback to us, unlike Safaricom.
TIGO_CALLBACK_USERNAME=
TIGO_CALLBACK_PASSWORD=
TIGO_CURRENCY=TZS
TIGO_MIN_AMOUNT=1000
TIGO_MAX_AMOUNT=5000000
# Rollout gate: merchant surfaces cannot reach Tigo until enabled + allowlisted.
TIGO_ENABLED=false
TIGO_ENABLED_ACCOUNT_IDS=

MAIL_ENABLED=false
MAILTRAP_API_TOKEN=
MAIL_FROM_ADDRESS=hello@demomailtrap.co
MAIL_FROM_NAME=TRANSCHAP PLATFORM

# Platform WhatsApp via openWA sidecar — primary customer order notifier
# until Meta Cloud API. Run: whatsapp-agent/run.sh
# Admin → WhatsApp: scan QR once. Merchants do not connect their own number.
# Set OPENWA_ENABLED=true once the agent is linked (Admin shows ready).
OPENWA_ENABLED=false
OPENWA_AGENT_URL=http://127.0.0.1:7010
OPENWA_AGENT_TOKEN=
OPENWA_AGENT_PORT=7010
# Optional openWA commercial license key
OPENWA_LICENSE_KEY=
# false = Chrome window for first QR scan; true after linked / on servers
OPENWA_HEADLESS=false

# Africa's Talking SMS — merchant + rider phone OTPs.
# Sandbox: AFRICASTALKING_USERNAME=sandbox and the sandbox API key.
# Live: your AT app username, live API key, AFRICASTALKING_SANDBOX=false.
# Optional AFRICASTALKING_SENDER_ID is a registered sender ID / shortcode.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=true

GOOGLE_MAPS_API_KEY=
# Optional: Cloud map ID for Advanced Markers (Google Cloud Console → Map Management).
GOOGLE_MAPS_MAP_ID=

IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

DM_AGENT_ENABLED=true
DM_AGENT_PROVIDER=auto
COMMENT_AGENT_ENABLED=true
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GEMINI_CHAT_MODEL=gemini-2.5-flash

BACKEND_URL=http://127.0.0.1:7001
NEXT_PUBLIC_API_URL=
# Frontend debug UI (diagnostic panels + replace Next "Rendering…" with loading effect).
# Defaults to on in non-production if unset. Must be false on a production build.
# Truthy: 1 | true | yes
NEXT_PUBLIC_DEBUG=true
